# Deriv OAuth — use your Vercel production URL (localhost is not supported by Deriv)
DERIV_APP_ID=
DERIV_REDIRECT_URI=https://deriv-trading-app-jade.vercel.app/api/auth/callback

# iron-session cookie encryption (min 32 characters)
SESSION_SECRET=change-me-to-a-long-random-secret-value

# Public app origin (must match the deployed site)
NEXT_PUBLIC_APP_URL=https://deriv-trading-app-jade.vercel.app
